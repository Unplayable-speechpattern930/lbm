#include <windows.h>
#pragma code_page(65001)

#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "lbm.manifest"

101 ICON "../icon/lbm.ico"


VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WESMAR"
            VALUE "FileDescription", "Lenovo Battery Manager - Native CLI/GUI"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "lbm"
            VALUE "LegalCopyright", "Copyright © 2026 Marek Wesołowski - WESMAR"
            VALUE "OriginalFilename", "lbm.exe"
            VALUE "ProductName", "Lenovo Battery Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
